# Copy to .env in the repository root. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Backend SQLite file. Existing commitments are already excluded from budget.
DATABASE_PATH=data/purchasing.db

# Server-only Next.js setting. Never prefix the API key with NEXT_PUBLIC_.
BACKEND_URL=http://127.0.0.1:8000
